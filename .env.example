# GEMINI_API_KEY: server-side Gemini key. Used ONLY by the backend proxy
# (server/index.mjs) and NEVER sent to the browser. No VITE_ prefix — that would
# inline it into the client bundle and leak it. Leave unset to require each user
# to bring their own key via the in-app panel.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: port the backend server listens on (defaults to 8080).
PORT="8080"

# APP_URL: The URL where this app is hosted. Used for self-referential links.
APP_URL="MY_APP_URL"
